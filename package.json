{
  "name": "accounting-workspace",
  "private": true,
  "workspaces": [
    "src/api",
    "src/frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @accounting/api",
    "dev:web": "npm run dev --workspace @accounting/frontend",
    "build": "npm run build --workspace @accounting/api && npm run build --workspace @accounting/frontend",
    "test": "npm test --workspace @accounting/api"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
       "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
       "vitest": "^4.1.11"
  }
}
